# ── identity ──────────────────────────────────────────────
BOT_NAME=Pixel X Ultra
OWNER_NAME=Pixel X Ultra
PREFIX=.

# ── how to log in (pick ONE) ──────────────────────────────
# 1) paste a session string — starts connected, no menu
SESSION_ID=

# 2) pair with a phone number, non-interactive — prints the 8-char code
#    (leave both empty to get the numbered menu on first start)
PHONE_NUMBER=

# ── optional ──────────────────────────────────────────────
# who may run owner commands (defaults to the bot's own number)
OWNER_NUMBER=
# extra owner number
SUDO_NUMBER=
# health endpoint; panel/VPS consoles can leave this empty
PORT=
