# ── identity ──────────────────────────────────────────────
BOT_NAME=Pixel X Ultra
OWNER_NAME=Pixel X Ultra
PREFIX=.

# ── how to log in (pick ONE) ─────────────────────────────
# 1) paste a session string — starts connected, no menu
SESSION_ID=

# 2) pair with a phone number, non-interactive — prints the 8-char code
#    (leave empty to get the numbered menu on first start instead)
PAIR_PHONE=

# ── optional links shown in the AI prompt ────────────────
OWNER_TG=
OWNER_SITE=
OWNER_YT=
OWNER_GH=

# ── library ──────────────────────────────────────────────
# auto | whiskeysockets | blacklord | baileys
WA_LIB=auto

PORT=3000
